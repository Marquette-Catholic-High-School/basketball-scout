# Basketball Scout settings
# =========================
#
# Copy this file to .env and edit it. scripts/install.sh (servers) and scripts/dev.sh
# (laptops) create .env for you. The web app and the worker read .env when they
# start, so restart both after a change:
#
#   sudo systemctl restart basketball-scout-web basketball-scout-worker
#
# Format rules. The same file is read by Python and by systemd, so keep it simple:
#   * One KEY=value per line, no spaces around "=".
#   * Comments go on their own line. Never put "# ..." after a value.
#   * Wrap a value that contains spaces, "#", "$", "\" or quotes in single quotes,
#     e.g. SCOUT_AUTH_PASSWORD_HASH='pbkdf2_sha256$600000$...'
#   * A commented-out line ("# KEY=value") means "use the built-in default".
#
# Every setting is listed below with its default value.
# Full reference: README.md > "Configuration reference".


# --- Server ----------------------------------------------------------------------

# Address and port used by `scout-web` (`make run-web` and scripts/dev.sh take HOST /
# PORT or --port instead). On a server installed with scripts/install.sh the systemd
# unit passes its own --host/--port (127.0.0.1 when nginx is in front); change the port
# there with `sudo scripts/install.sh --port N`.
SCOUT_HOST=0.0.0.0
SCOUT_PORT=8000

# debug | info | warning | error
SCOUT_LOG_LEVEL=info

# Where games, film and the database are stored. A relative path is relative to the
# repository folder. install.sh sets /var/lib/basketball-scout. To move it on a server,
# stop both services, copy the folder, then run
# `sudo scripts/install.sh --data-dir /new/path` so systemd allows writing there.
SCOUT_DATA_DIR=data

# SQLite database file. Default: <SCOUT_DATA_DIR>/scout.db. On a server keep it inside
# SCOUT_DATA_DIR: the systemd services may not write anywhere else.
# SCOUT_DB_PATH=/var/lib/basketball-scout/scout.db

# The address coaches type, e.g. https://scout.example.org. Used in log messages only.
# SCOUT_PUBLIC_BASE_URL=https://scout.example.org


# --- Sign-in (HTTP basic auth) ------------------------------------------------------

SCOUT_AUTH_USERNAME=coach

# Plain-text password. install.sh generates a strong one; scripts/dev.sh uses "dev".
# With no password (and no hash) every page answers "Sign-in is not set up".
SCOUT_AUTH_PASSWORD=

# Or store a hash instead of the password (the hash wins when both are set). Create one
# with `.venv/bin/python -m scout.auth hash-password` and keep the single quotes.
# SCOUT_AUTH_PASSWORD_HASH='pbkdf2_sha256$600000$...$...'

# true switches sign-in off completely. Only on a private, trusted network.
SCOUT_AUTH_DISABLED=false


# --- Uploads ---------------------------------------------------------------------

# Largest film accepted, in GB. A 60-minute 1080p game is usually 2-6 GB.
SCOUT_MAX_UPLOAD_GB=12

# Size of each upload request in MB. Keep it below nginx's client_max_body_size
# (64m in deploy/nginx/basketball-scout.conf).
SCOUT_UPLOAD_CHUNK_MB=16

# Longest film accepted, in minutes (checked when ffprobe is installed).
SCOUT_MAX_VIDEO_MINUTES=150


# --- Job queue and worker ----------------------------------------------------------

# sqlite (default, nothing to install) | redis (sudo scripts/install.sh --with-redis)
SCOUT_QUEUE_BACKEND=sqlite
SCOUT_REDIS_URL=redis://localhost:6379/0

# Prefix for Basketball Scout's Redis keys. Change it if the Redis server is shared.
SCOUT_REDIS_PREFIX=scout

# Jobs one worker runs at the same time (1-16). Most of a job is waiting on the GPU.
SCOUT_WORKER_CONCURRENCY=2

# A worker that stops checking in loses its job after this many seconds (minimum 30);
# another worker then picks the job up and resumes it.
SCOUT_JOB_LEASE_SECONDS=300

# How many times a job may be picked up before it fails with WORKER_LOST (minimum 1).
SCOUT_JOB_MAX_ATTEMPTS=3


# --- Video processing (GPU) ----------------------------------------------------------

# modal  - serverless GPU on Modal (default)
# mock   - no GPU: synthetic demo data, for trying the app out
# local  - this machine's NVIDIA GPU (pip install -r modal_app/requirements-gpu.txt)
SCOUT_PROCESSOR=modal

# Modal credentials: paste a token from the Modal dashboard (Settings > API Tokens),
# or run `modal token new` as the service user, which writes ~/.modal.toml instead.
# Keep these two lines commented out when you use ~/.modal.toml: an empty value here
# would hide the token file from Modal.
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...

# Names of the deployed Modal app and its storage. Change them only together with
# modal_app/app.py.
SCOUT_MODAL_APP_NAME=basketball-scout
SCOUT_MODAL_FUNCTION_NAME=process_video
SCOUT_MODAL_VOLUME_NAME=basketball-scout-data
SCOUT_MODAL_PROGRESS_DICT=basketball-scout-progress

# Modal environment. Default: the workspace's default environment. install.sh and
# update.sh deploy into SCOUT_MODAL_ENVIRONMENT; also set MODAL_ENVIRONMENT to the same
# value for Modal commands you run yourself (`make deploy-modal`, `modal run ...`).
# SCOUT_MODAL_ENVIRONMENT=main
# MODAL_ENVIRONMENT=main

# How often the worker checks on a running GPU job, in seconds (minimum 1).
SCOUT_MODAL_POLL_SECONDS=10

# Give up on a GPU job after this many hours, counted from the start of the job (the
# worker then cancels the GPU call). Keep it longer than SCOUT_MODAL_TIMEOUT_S below
# (which is in seconds).
SCOUT_MODAL_MAX_WAIT_HOURS=8

# Delete the film and the results from the Modal volume once they are downloaded.
SCOUT_MODAL_CLEANUP=true

# Deploy-time options. modal_app/app.py reads these when you run `modal deploy`; the
# web app ignores them. Redeploy after a change: sudo scripts/update.sh --deploy-modal
# GPU type (default A10G, 24 GB):
# SCOUT_MODAL_GPU=A10G
# Time limit for one film on the GPU, in seconds (default 21600 = 6 hours, at most 86400).
# Above 8 hours also raise SCOUT_MODAL_MAX_WAIT_HOURS, or the worker gives up first:
# SCOUT_MODAL_TIMEOUT_S=21600
# Most GPU containers running at the same time, a cost cap (default 2):
# SCOUT_MODAL_MAX_CONTAINERS=2

# Frames per second analysed. Lower is faster and cheaper but can miss quick plays.
SCOUT_ANALYSIS_FPS=15

# Frames are scaled so their longer side is at most this many pixels (320-3840).
SCOUT_ANALYSIS_MAX_SIDE=1280

# Render the annotated video (boxes, jersey numbers, ball trail) for playback.
SCOUT_RENDER_ANNOTATED_VIDEO=true

# Height of the annotated video in pixels (240-2160).
SCOUT_RENDER_HEIGHT=720

# Custom model checkpoints for the GPU pipeline (a path on the Modal volume, or on this
# machine for SCOUT_PROCESSOR=local). Leave commented out to use the built-in models.
# SCOUT_DETECTOR_WEIGHTS=weights/my-detector.pth
# SCOUT_COURT_KEYPOINT_WEIGHTS=weights/my-court-model.pt

# Seconds of pretend GPU time for SCOUT_PROCESSOR=mock.
SCOUT_MOCK_SECONDS=8

# Only for SCOUT_PROCESSOR=local: where OpenHoopVision is installed.
# OHV_HOME=/opt/openhoopvision


# --- Claude scouting report ------------------------------------------------------------

# API key from https://console.anthropic.com (Settings > API Keys). Without it the
# stats and exports still work; only the written report is unavailable.
ANTHROPIC_API_KEY=

SCOUT_CLAUDE_MODEL=claude-opus-5-5

# How hard Claude thinks: low | medium | high | xhigh | max. Higher costs more.
SCOUT_CLAUDE_EFFORT=high

# Most output tokens per report, thinking included (2048-128000). Raise it when a
# report fails with REPORT_TRUNCATED.
SCOUT_CLAUDE_MAX_TOKENS=32000

# If Claude declines, let the API retry on a fallback model automatically.
SCOUT_CLAUDE_FALLBACKS=true

# Seconds to wait for one report before giving up.
SCOUT_CLAUDE_TIMEOUT_S=900

# Write the report automatically when an analysis finishes (false: click
# "Generate report" on the game page instead).
SCOUT_AUTO_REPORT=true


# --- Config files (relative to the repository folder) ------------------------------------

# FastScout export columns (see docs/FASTSCOUT.md).
SCOUT_FASTSCOUT_CONFIG=config/fastscout_columns.yaml

# Court size and line positions (set length_ft for the opponent's gym).
SCOUT_COURT_CONFIG=config/court.yaml

# Play-recognition thresholds.
SCOUT_PLAY_RULES_CONFIG=config/play_rules.yaml
